{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:5173"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "wix": {
        "language": "ja-JP"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "copyright": "© 2020 Noritaka IZUMI",
    "category": "EducationalGame",
    "shortDescription": "フラッシュ暗算",
    "longDescription": "フラッシュ暗算。連続で表示される数字を計算するゲームです。",
    "externalBin": [],
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "productName": "Aurora Flash",
  "mainBinaryName": "Aurora Flash",
  "identifier": "com.fairyselect.auroraflash",
  "plugins": {},
  "app": {
    "windows": [
      {
        "title": "おーろら★ふらっしゅ",
        "maximized": true,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
